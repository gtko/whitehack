{
  "name": "veille-ads",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "build": "wrangler deploy --dry-run --outdir dist",
    "db:migrate": "wrangler d1 migrations apply veille-ads --remote",
    "db:migrate:local": "wrangler d1 migrations apply veille-ads --local"
  },
  "dependencies": {
    "@cloudflare/puppeteer": "^1.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261117.1",
    "typescript": "^5.7.0",
    "wrangler": "^4.0.0"
  }
}
